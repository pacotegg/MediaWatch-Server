{
  "name": "mediawatch-server",
  "version": "1.1.6",
  "description": "Servidor propio de películas y series todo-en-uno para Windows y Linux",
  "main": "dist-electron/main.js",
  "author": "Paco Gámiz <pacotegg@users.noreply.github.com>",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "prepare:binaries": "node scripts/prepare-binaries.js && node scripts/prepare-node.js && node scripts/prepare-server-deps.js",
    "build:core": "cd core && npm run build --workspace web",
    "build:electron": "tsc",
    "build": "npm run prepare:binaries && npm run build:core && npm run build:electron",
    "dev": "tsc && electron dist-electron/main.js",
    "start": "electron dist-electron/main.js",
    "dist": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "casa.mediawatch.server",
    "publish": [
      {
        "provider": "github",
        "owner": "pacotegg",
        "repo": "MediaWatch-Server",
        "releaseType": "release"
      }
    ],
    "productName": "MediaWatch Server",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video",
      "icon": "assets/icon.png",
      "maintainer": "Paco Gámiz <pacotegg@users.noreply.github.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "installer/instalador.nsh"
    },
    "extraResources": [
      {
        "from": "core/server",
        "to": "core/server",
        "filter": [
          "**/*",
          "!**/node_modules/**"
        ]
      },
      {
        "from": "build/server-deps/node_modules",
        "to": "core/node_modules"
      },
      {
        "from": "core/web/dist",
        "to": "core/web/dist"
      },
      {
        "from": "app/wizard",
        "to": "app/wizard"
      },
      {
        "from": "app/connect",
        "to": "app/connect"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "bin",
        "to": "bin"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4"
  }
}
