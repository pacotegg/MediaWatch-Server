{
  "name": "mediawatch-server",
  "version": "1.1.2",
  "description": "Servidor propio de películas y series todo-en-uno para Windows y Linux",
  "main": "dist-electron/main.js",
  "author": "Paco Gámiz <pacotegg@users.noreply.github.com>",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "prepare:binaries": "node scripts/prepare-binaries.js",
    "build:core": "cd core && npm run build --workspace web",
    "build:electron": "tsc",
    "build": "npm run prepare:binaries && npm run build:core && npm run build:electron",
    "dev": "tsc && electron dist-electron/main.js",
    "start": "electron dist-electron/main.js",
    "dist": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.6",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "casa.mediawatch.server",
    "productName": "MediaWatch Server",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Video",
      "icon": "assets/icon.png",
      "maintainer": "Paco Gámiz <pacotegg@users.noreply.github.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "core/server",
        "to": "core/server",
        "filter": [
          "**/*",
          "!**/node_modules/**"
        ]
      },
      {
        "from": "core/web/dist",
        "to": "core/web/dist"
      },
      {
        "from": "app/wizard",
        "to": "app/wizard"
      },
      {
        "from": "app/connect",
        "to": "app/connect"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "bin",
        "to": "bin"
      }
    ]
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
